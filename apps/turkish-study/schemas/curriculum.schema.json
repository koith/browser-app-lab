{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:turkce120:curriculum:1",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "object"
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "days": {
      "type": "array",
      "minItems": 120,
      "maxItems": 120,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^D(?:00[1-9]|0[1-9][0-9]|1[01][0-9]|120)$"
          },
          "day": {
            "type": "integer",
            "minimum": 1,
            "maximum": 120
          },
          "week": {
            "type": "integer",
            "minimum": 1,
            "maximum": 18
          },
          "level": {
            "enum": [
              "A1",
              "A2"
            ]
          },
          "theme": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "minutes": {
            "type": "integer",
            "const": 60
          },
          "kind": {
            "enum": [
              "lesson",
              "review",
              "assessment"
            ]
          },
          "contentStatus": {
            "type": "string",
            "minLength": 1
          },
          "reviewStatus": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "day",
          "week",
          "level",
          "theme",
          "title",
          "minutes",
          "kind",
          "contentStatus",
          "reviewStatus",
          "sources"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "version",
    "status",
    "target",
    "sources",
    "days"
  ],
  "additionalProperties": true
}